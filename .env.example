# =============================================================
#  MONWOLF BUY BOT — environment
# =============================================================

# Telegram (get bot token from @BotFather, chat ID from @userinfobot)
TG_BOT_TOKEN=
TG_CHAT_ID=

# OpenAI (your existing key — bot uses gpt-4o-mini for cheap pack chatter)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Monad RPC (your Alchemy endpoint)
RPC_URL=https://monad-mainnet.g.alchemy.com/v2/YOUR_KEY_HERE

# Monwolf token + LP pair
MONWOLF_TOKEN=0x8361a59d340466211ad4aB41C09a32e4530a7777
MONWOLF_LP_PAIR=
WMON=0x3bd359C1119dA7Da1D913D1C4D2B7c461115433A

# Settings
MIN_BUY_USD=1            # ignore dust buys under this
WHALE_BUY_USD=500        # 🚨 alpha siren above this
POLL_INTERVAL_MS=3000    # how often to check for new swaps
AI_REPLY_CHANCE=0.35     # bot AI-responds to ~35% of mentions (not spammy)
AI_COOLDOWN_SEC=20       # max one AI reply every 20s globally
LP_DROP_ALERT_PCT=15     # ping admins if LP drops this much

# =============================================================
#  PREMIUM CUSTOM EMOJIS (optional)
#  Telegram Premium animated emojis. Get IDs by:
#    1. Send the emoji in any chat
#    2. Reply to your own message with /id (via @ShowJsonBot)
#    3. Copy the custom_emoji_id from the JSON response
#  Leave blank to use regular fallback emojis.
# =============================================================
EMOJI_WOLF_ID=
EMOJI_WHALE_ID=
